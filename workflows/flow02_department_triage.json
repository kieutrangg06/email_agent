{
  "name": "Luồng 2 - AI Multi-Department Triage & Acknowledgment (12 Nodes)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "m1-flow2-triage",
        "responseMode": "onReceived",
        "responseData": "OK",
        "options": {}
      },
      "id": "flow2-node-1",
      "name": "1. Flow 2 Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "m1-flow2-triage"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:4000/api/v1/triage/departments",
        "options": {}
      },
      "id": "flow2-node-2",
      "name": "2. Fetch Depts HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const prev = $('1. Flow 2 Webhook Trigger').first().json;\nconst payload = prev.body ? prev.body : prev;\n\nconst subject = (payload.subject || \"\").toLowerCase();\nconst body = (payload.body || \"\").toLowerCase();\nconst text = subject + \" \" + body;\n\nlet category = \"General\";\nlet priority = \"P4 - Low\";\nlet sentiment = \"Trung tinh\";\nlet urgencyReason = \"Yêu cầu thông tin và hỗ trợ chung tiêu chuẩn\";\n\nif (text.includes(\"sập\") || text.includes(\"504\") || text.includes(\"500\") || text.includes(\"không truy cập\") || text.includes(\"khẩn cấp\") || text.includes(\"down\") || text.includes(\"outage\")) {\n  category = \"Technical\";\n  priority = \"P1 - Critical\";\n  sentiment = \"Khan cap\";\n  urgencyReason = \"Hệ thống ghi nhận sự cố gián đoạn dịch vụ diện rộng cần xử lý khẩn\";\n} else if (text.includes(\"lỗi\") || text.includes(\"api\") || text.includes(\"bug\") || text.includes(\"database\") || text.includes(\"không đăng nhập\") || text.includes(\"mật khẩu\")) {\n  category = \"Technical\";\n  priority = \"P2 - High\";\n  sentiment = \"Tieu cuc\";\n  urgencyReason = \"Yêu cầu hỗ trợ khắc phục sự cố kỹ thuật chức năng\";\n} else if (text.includes(\"báo giá\") || text.includes(\"mua hàng\") || text.includes(\"hợp đồng\") || text.includes(\"bản quyền\") || text.includes(\"tư vấn\")) {\n  category = \"Sales\";\n  priority = \"P2 - High\";\n  sentiment = \"Tich cuc\";\n  urgencyReason = \"Yêu cầu tư vấn cơ hội kinh doanh và báo giá giải pháp\";\n} else if (text.includes(\"hóa đơn\") || text.includes(\"vat\") || text.includes(\"công nợ\") || text.includes(\"thanh toán\") || text.includes(\"chứng từ\")) {\n  category = \"Finance\";\n  priority = \"P3 - Medium\";\n  sentiment = \"Trung tinh\";\n  urgencyReason = \"Yêu cầu đối soát chứng từ và phát hành hóa đơn kế toán\";\n}\n\nreturn [{\n  json: {\n    ...payload,\n    sender_email: payload.sender_email || payload.from || \"guest@enterprise.com\",\n    sender_name: payload.sender_name || payload.name || \"Khách Hàng\",\n    subject: payload.subject || \"Yêu cầu tiếp nhận\",\n    body: payload.body || payload.text || \"\",\n    category: category,\n    priority: priority,\n    sentiment: sentiment,\n    urgency_reason: urgencyReason\n  }\n}];\n"
      },
      "id": "flow2-node-3",
      "name": "3. AI Department Classifier Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const current = $input.first().json;\n\nlet slaHours = 24;\nif (current.priority.includes('P1')) slaHours = 2;\nelse if (current.priority.includes('P2')) slaHours = 4;\nelse if (current.priority.includes('P3')) slaHours = 8;\nelse if (current.priority.includes('P4')) slaHours = 24;\n\nconst slaDeadlineDate = new Date(Date.now() + slaHours * 3600 * 1000);\nconst slaDeadlineStr = slaDeadlineDate.toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', hour12: false });\nconst category = current.category || 'General';\nconst subject = current.subject || 'Không có tiêu đề';\nconst sender = current.sender_email || 'Quý Khách';\nconst senderName = current.sender_name || 'Quý Khách Hàng';\n\nlet emailSubject = '';\nlet emailHtml = '';\nlet emailText = '';\n\nif (category === 'Technical') {\n  emailSubject = `🛠️ [VKU HELPDESK] TIẾP NHẬN SỰ CỐ KỸ THUẬT: ${subject} | Cam kết SLA: ${slaHours} Giờ`;\n  emailText = `[TRUNG TÂM HỖ TRỢ KỸ THUẬT DOANH NGHIỆP - VKU HELPDESK]\nKính gửi ${senderName} (${sender}),\n\nHệ thống AI Triage tự động đã tiếp nhận và phân loại yêu cầu của Quý Khách vào danh mục: HỖ TRỢ KỸ THUẬT & HẠ TẦNG.\n- Tiêu đề yêu cầu: ${subject}\n- Mức độ ưu tiên: ${current.priority}\n- Cam kết thời hạn xử lý SLA: Trong vòng ${slaHours} giờ (Trước ${slaDeadlineStr})\n- Trạng thái: Đang kích hoạt điều phối kỹ sư chuyên trách\n\nHướng dẫn sơ bộ: Nếu gặp lỗi gián đoạn dịch vụ, Quý Khách có thể chụp ảnh màn hình hoặc đính kèm log lỗi gửi phản hồi trực tiếp vào thư này.\nHotline Kỹ thuật trực 24/7: 1900 8888 (Nhánh 1).\nCổng tra cứu: http://localhost:3000/tickets\n\nTrân trọng,\nĐội ngũ Kỹ sư Hạ tầng & Tự động hóa Doanh nghiệp VKU`;\n\n  emailHtml = `<!DOCTYPE html>\n<html lang=\"vi\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Xác Nhận Hỗ Trợ Kỹ Thuật</title></head>\n<body style=\"margin:0;padding:0;background-color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;color:#1e293b;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#0f172a;padding:40px 15px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"640\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);max-width:640px;width:100%;\">\n        <tr>\n          <td style=\"background:linear-gradient(135deg, #1e3a8a 0%, #2563eb 60%, #3b82f6 100%);padding:36px 40px;color:#ffffff;text-align:center;\">\n            <div style=\"display:inline-block;background:rgba(255,255,255,0.15);padding:6px 18px;border-radius:999px;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;margin-bottom:14px;\">\n              🛠️ TRUNG TÂM HỖ TRỢ KỸ THUẬT &bull; 24/7 HELPDESK\n            </div>\n            <h1 style=\"margin:0;font-size:23px;font-weight:900;text-transform:uppercase;line-height:1.3;\">\n              XÁC NHẬN TIẾP NHẬN SỰ CỐ KỸ THUẬT\n            </h1>\n            <p style=\"margin:10px 0 0;font-size:13px;color:#dbeafe;\">\n              Cam kết chất lượng dịch vụ SLA &bull; Điều phối chuyên viên tự động\n            </p>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding:36px 40px 28px;\">\n            <p style=\"margin:0 0 16px;font-size:15px;color:#0f172a;line-height:1.6;\">\n              Kính gửi <strong>${senderName}</strong>,\n            </p>\n            <p style=\"margin:0 0 24px;font-size:14px;color:#475569;line-height:1.6;\">\n              Hệ thống Điều phối Tự động đã phân loại thành công yêu cầu của Quý Khách vào danh mục <strong>Hỗ trợ Kỹ thuật &amp; Hạ tầng</strong>.\n            </p>\n            <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#eff6ff;border:1px solid #bfdbfe;border-radius:14px;overflow:hidden;margin-bottom:24px;\">\n              <tr>\n                <td style=\"background:#dbeafe;padding:12px 20px;border-bottom:1px solid #bfdbfe;font-size:13px;font-weight:800;color:#1e40af;text-transform:uppercase;\">\n                  📌 THÔNG TIN TIẾP NHẬN YÊU CẦU\n                </td>\n              </tr>\n              <tr>\n                <td style=\"padding:20px;\">\n                  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"8\">\n                    <tr><td width=\"36%\" style=\"font-size:13px;color:#1e40af;font-weight:600;\">Tiêu đề sự cố:</td><td style=\"font-size:13px;font-weight:800;color:#0f172a;\">${subject}</td></tr>\n                    <tr><td style=\"font-size:13px;color:#1e40af;font-weight:600;\">Phòng ban xử lý:</td><td><span style=\"background:#2563eb;color:#ffffff;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:700;\">Hỗ trợ Kỹ thuật (Technical)</span></td></tr>\n                    <tr><td style=\"font-size:13px;color:#1e40af;font-weight:600;\">Mức độ khẩn cấp:</td><td><strong style=\"color:#dc2626;font-size:13px;\">${current.priority}</strong></td></tr>\n                    <tr><td style=\"font-size:13px;color:#1e40af;font-weight:600;\">Thời hạn cam kết SLA:</td><td><strong style=\"color:#059669;font-size:13px;\">⏰ Trong vòng ${slaHours} giờ (Trước ${slaDeadlineStr})</strong></td></tr>\n                  </table>\n                </td>\n              </tr>\n            </table>\n\n            <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n              <tr>\n                <td align=\"center\">\n                  <a href=\"http://localhost:3000/tickets\" target=\"_blank\" style=\"display:inline-block;background:linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;padding:14px 32px;border-radius:10px;box-shadow:0 6px 18px rgba(37,99,235,0.35);\">\n                    👉 THEO DÕI TIẾN ĐỘ TẠI CỔNG HELPDESK CRM\n                  </a>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"background:#f8fafc;border-top:1px solid #e2e8f0;padding:24px 40px;text-align:center;\">\n            <p style=\"margin:0 0 4px;font-size:12px;font-weight:800;color:#334155;\">VKU ENTERPRISE HELPDESK &bull; TRUNG TÂM HỖ TRỢ KỸ THUẬT</p>\n            <p style=\"margin:0;font-size:11px;color:#64748b;\">Hotline Khẩn cấp: 1900 8888 (Nhánh 1)</p>\n          </td>\n        </tr>\n      </table>\n    </td></tr>\n  </table>\n</body></html>`;\n\n} else if (category === 'Sales') {\n  emailSubject = `💼 [VKU SOLUTIONS] TIẾP NHẬN YÊU CẦU TƯ VẤN & BÁO GIÁ: ${subject}`;\n  emailText = `[BAN PHÁT TRIỂN DOANH NGHIỆP & ĐỐI TÁC - VKU SOLUTIONS]\nKính gửi ${senderName} (${sender}),\n\nChúng tôi đã tiếp nhận yêu cầu tư vấn giải pháp của Quý Khách:\n- Nhu cầu tiếp nhận: ${subject}\n- Bộ phận phụ trách: Ban Phát Triển Kinh Doanh (Sales)\n- Cam kết liên hệ: Trong vòng ${slaHours} giờ làm việc (Trước ${slaDeadlineStr})\n\nChuyên viên Tư vấn Doanh nghiệp sẽ liên hệ trực tiếp trong thời gian sớm nhất.\nEmail: sales@enterprise-automation.vn | Hotline: 1900 8888 (Nhánh 2).\n\nTrân trọng,\nBan Phát Triển Doanh Nghiệp VKU Solutions`;\n\n  emailHtml = `<!DOCTYPE html>\n<html lang=\"vi\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Tư Vấn Giải Pháp</title></head>\n<body style=\"margin:0;padding:0;background-color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;color:#1e293b;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#0f172a;padding:40px 15px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"640\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);max-width:640px;width:100%;\">\n        <tr>\n          <td style=\"background:linear-gradient(135deg, #065f46 0%, #059669 60%, #10b981 100%);padding:36px 40px;color:#ffffff;text-align:center;\">\n            <div style=\"display:inline-block;background:rgba(255,255,255,0.15);padding:6px 18px;border-radius:999px;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;margin-bottom:14px;\">\n              💼 BAN PHÁT TRIỂN DOANH NGHIỆP & ĐỐI TÁC\n            </div>\n            <h1 style=\"margin:0;font-size:23px;font-weight:900;text-transform:uppercase;line-height:1.3;\">\n              CHÀO MỪNG QUÝ ĐỐI TÁC DOANH NGHIỆP\n            </h1>\n            <p style=\"margin:10px 0 0;font-size:13px;color:#d1fae5;\">\n              Hệ thống Giải pháp Tự động hóa Quy trình Nghiệp vụ Toàn diện\n            </p>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding:36px 40px 28px;\">\n            <p style=\"margin:0 0 16px;font-size:15px;color:#0f172a;line-height:1.6;\">\n              Kính gửi <strong>${senderName}</strong>,\n            </p>\n            <p style=\"margin:0 0 24px;font-size:14px;color:#475569;line-height:1.6;\">\n              Yêu cầu tư vấn của Quý Khách đã được chuyển tiếp tới Ban Phát Triển Kinh Doanh để chuẩn bị Hồ sơ Năng lực và Báo giá:\n            </p>\n            <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#ecfdf5;border:1px solid #a7f3d0;border-radius:14px;overflow:hidden;margin-bottom:24px;\">\n              <tr>\n                <td style=\"background:#d1fae5;padding:12px 20px;border-bottom:1px solid #a7f3d0;font-size:13px;font-weight:800;color:#065f46;text-transform:uppercase;\">\n                  📋 THÔNG TIN YÊU CẦU TƯ VẤN\n                </td>\n              </tr>\n              <tr>\n                <td style=\"padding:20px;\">\n                  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"8\">\n                    <tr><td width=\"36%\" style=\"font-size:13px;color:#065f46;font-weight:600;\">Nhu cầu giải pháp:</td><td style=\"font-size:13px;font-weight:800;color:#0f172a;\">${subject}</td></tr>\n                    <tr><td style=\"font-size:13px;color:#065f46;font-weight:600;\">Bộ phận phụ trách:</td><td><span style=\"background:#059669;color:#ffffff;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:700;\">Tư vấn Doanh nghiệp (Sales)</span></td></tr>\n                    <tr><td style=\"font-size:13px;color:#065f46;font-weight:600;\">Cam kết liên hệ lại:</td><td><strong style=\"color:#059669;font-size:13px;\">Trong vòng ${slaHours} giờ làm việc (Trước ${slaDeadlineStr})</strong></td></tr>\n                  </table>\n                </td>\n              </tr>\n            </table>\n\n            <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n              <tr>\n                <td align=\"center\">\n                  <a href=\"http://localhost:3000/tickets\" target=\"_blank\" style=\"display:inline-block;background:linear-gradient(135deg, #065f46 0%, #059669 100%);color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;padding:14px 32px;border-radius:10px;box-shadow:0 6px 18px rgba(5,150,105,0.35);\">\n                    👉 XEM CHI TIẾT TẠI CỔNG THÔNG TIN DOANH NGHIỆP\n                  </a>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"background:#f8fafc;border-top:1px solid #e2e8f0;padding:24px 40px;text-align:center;\">\n            <p style=\"margin:0 0 4px;font-size:12px;font-weight:800;color:#334155;\">VKU ENTERPRISE SOLUTIONS &bull; BAN PHÁT TRIỂN THỊ TRƯỜNG</p>\n            <p style=\"margin:0;font-size:11px;color:#64748b;\">Hotline: 1900 8888 (Nhánh 2)</p>\n          </td>\n        </tr>\n      </table>\n    </td></tr>\n  </table>\n</body></html>`;\n\n} else if (category === 'Finance') {\n  emailSubject = `📑 [VKU FINANCE] XÁC NHẬN TIẾP NHẬN CHỨNG TỪ & HÓA ĐƠN VAT: ${subject}`;\n  emailText = `[PHÒNG TÀI CHÍNH - KẾ TOÁN DOANH NGHIỆP - VKU FINANCE]\nKính gửi ${senderName} (${sender}),\n\nHệ thống đã tiếp nhận hồ sơ chứng từ của Quý Khách:\n- Nội dung chứng từ: ${subject}\n- Bộ phận xử lý: Phòng Kế toán & Đối soát Công nợ (Finance)\n- Thời hạn đối soát: Trong vòng ${slaHours} giờ làm việc (Trước ${slaDeadlineStr})\n\nKế toán viên phụ trách đang tiến hành đối chiếu số học và kiểm tra hóa đơn điện tử hợp lệ.\nEmail: ke-toan@enterprise-automation.vn | Hotline: 1900 8888 (Nhánh 3).\n\nTrân trọng,\nPhòng Tài Chính & Kế Toán VKU Enterprise`;\n\n  emailHtml = `<!DOCTYPE html>\n<html lang=\"vi\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Xác Nhận Hồ Sơ Tài Chính</title></head>\n<body style=\"margin:0;padding:0;background-color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;color:#1e293b;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#0f172a;padding:40px 15px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"640\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);max-width:640px;width:100%;\">\n        <tr>\n          <td style=\"background:linear-gradient(135deg, #0f766e 0%, #0d9488 60%, #14b8a6 100%);padding:36px 40px;color:#ffffff;text-align:center;\">\n            <div style=\"display:inline-block;background:rgba(255,255,255,0.15);padding:6px 18px;border-radius:999px;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;margin-bottom:14px;\">\n              📑 PHÒNG KẾ TOÁN & TÀI CHÍNH DOANH NGHIỆP\n            </div>\n            <h1 style=\"margin:0;font-size:23px;font-weight:900;text-transform:uppercase;line-height:1.3;\">\n              TIẾP NHẬN HỒ SƠ HÓA ĐƠN &amp; ĐỐI SOÁT\n            </h1>\n            <p style=\"margin:10px 0 0;font-size:13px;color:#ccfbf1;\">\n              Kiểm toán Chứng từ, Hóa đơn VAT Điện tử &amp; Đối soát Công nợ\n            </p>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding:36px 40px 28px;\">\n            <p style=\"margin:0 0 16px;font-size:15px;color:#0f172a;line-height:1.6;\">\n              Kính gửi <strong>${senderName}</strong>,\n            </p>\n            <p style=\"margin:0 0 24px;font-size:14px;color:#475569;line-height:1.6;\">\n              Hệ thống đã tiếp nhận hồ sơ chứng từ tài chính / hóa đơn thanh toán của Quý Khách.\n            </p>\n            <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f0fdfa;border:1px solid #99f6e4;border-radius:14px;overflow:hidden;margin-bottom:24px;\">\n              <tr>\n                <td style=\"background:#ccfbf1;padding:12px 20px;border-bottom:1px solid #99f6e4;font-size:13px;font-weight:800;color:#0f766e;text-transform:uppercase;\">\n                  📋 THÔNG TIN HỒ SƠ TIẾP NHẬN\n                </td>\n              </tr>\n              <tr>\n                <td style=\"padding:20px;\">\n                  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"8\">\n                    <tr><td width=\"36%\" style=\"font-size:13px;color:#0f766e;font-weight:600;\">Nội dung chứng từ:</td><td style=\"font-size:13px;font-weight:800;color:#0f172a;\">${subject}</td></tr>\n                    <tr><td style=\"font-size:13px;color:#0f766e;font-weight:600;\">Bộ phận xử lý:</td><td><span style=\"background:#0d9488;color:#ffffff;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:700;\">Tài chính - Kế toán (Finance)</span></td></tr>\n                    <tr><td style=\"font-size:13px;color:#0f766e;font-weight:600;\">Thời hạn đối soát:</td><td><strong style=\"color:#0f766e;font-size:13px;\">Trong vòng ${slaHours} giờ làm việc (Trước ${slaDeadlineStr})</strong></td></tr>\n                  </table>\n                </td>\n              </tr>\n            </table>\n\n            <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n              <tr>\n                <td align=\"center\">\n                  <a href=\"http://localhost:3000/tickets\" target=\"_blank\" style=\"display:inline-block;background:linear-gradient(135deg, #0f766e 0%, #0d9488 100%);color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;padding:14px 32px;border-radius:10px;box-shadow:0 6px 18px rgba(13,148,136,0.35);\">\n                    👉 THEO DÕI HỒ SƠ TẠI CỔNG QUẢN TRỊ CRM\n                  </a>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"background:#f8fafc;border-top:1px solid #e2e8f0;padding:24px 40px;text-align:center;\">\n            <p style=\"margin:0 0 4px;font-size:12px;font-weight:800;color:#334155;\">VKU ENTERPRISE FINANCE &bull; PHÒNG TÀI CHÍNH KẾ TOÁN</p>\n            <p style=\"margin:0;font-size:11px;color:#64748b;\">Hotline: 1900 8888 (Nhánh 3)</p>\n          </td>\n        </tr>\n      </table>\n    </td></tr>\n  </table>\n</body></html>`;\n\n} else {\n  // General Inquiry -> P4 - LOW (SLA 24 GIỜ)\n  emailSubject = `🌸 [VKU CUSTOMER CARE] TIẾP NHẬN YÊU CẦU HỖ TRỢ: ${subject} | Cam kết SLA: 24 Giờ`;\n  emailText = `[TRUNG TÂM CHĂM SÓC KHÁCH HÀNG & DỊCH VỤ - VKU CARE]\nKính gửi ${senderName} (${sender}),\n\nCảm ơn Quý Khách đã gửi thư liên hệ tới Hệ sinh thái Doanh nghiệp VKU.\n- Chủ đề thư: ${subject}\n- Phân loại: Hỏi đáp Chung & Dịch vụ Khách hàng (General Inquiries)\n- Mức độ ưu tiên: P4 - Low (Tiêu chuẩn)\n- Thời hạn cam kết SLA: Trong vòng 24 giờ (Trước ${slaDeadlineStr})\n\nThông tin Văn phòng & Giờ làm việc chi nhánh:\n- Địa chỉ: 470 Đường Trần Đại Nghĩa, Q. Ngũ Hành Sơn, TP. Đà Nẵng\n- Giờ mở cửa: Thứ Hai - Thứ Sáu (08:00 - 17:30) | Thứ Bảy (08:00 - 12:00)\n- Tổng đài CSKH: 1900 8888 (Miễn phí cước gọi)\nCổng tra cứu trực tuyến: http://localhost:3000/tickets\n\nTrân trọng phục vụ,\nBan Chăm Sóc Khách Hàng VKU Care`;\n\n  emailHtml = `<!DOCTYPE html>\n<html lang=\"vi\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Chăm Sóc Khách Hàng</title></head>\n<body style=\"margin:0;padding:0;background-color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;color:#1e293b;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#0f172a;padding:40px 15px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"640\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);max-width:640px;width:100%;\">\n        <tr>\n          <td style=\"background:linear-gradient(135deg, #be185d 0%, #db2777 60%, #ec4899 100%);padding:36px 40px;color:#ffffff;text-align:center;\">\n            <div style=\"display:inline-block;background:rgba(255,255,255,0.15);padding:6px 18px;border-radius:999px;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;margin-bottom:14px;\">\n              🌸 TRUNG TÂM CHĂM SÓC KHÁCH HÀNG & DỊCH VỤ\n            </div>\n            <h1 style=\"margin:0;font-size:23px;font-weight:900;text-transform:uppercase;line-height:1.3;\">\n              CẢM ƠN QUÝ KHÁCH ĐÃ LIÊN HỆ\n            </h1>\n            <p style=\"margin:10px 0 0;font-size:13px;color:#fce7f3;\">\n              Hướng dẫn dịch vụ, thông tin chi nhánh và lịch làm việc\n            </p>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding:36px 40px 28px;\">\n            <p style=\"margin:0 0 16px;font-size:15px;color:#0f172a;line-height:1.6;\">\n              Kính gửi <strong>${senderName}</strong>,\n            </p>\n            <p style=\"margin:0 0 24px;font-size:14px;color:#475569;line-height:1.6;\">\n              Chúng tôi đã nhận được thư của Quý Khách về chủ đề <strong>\"${subject}\"</strong>. Đội ngũ Chăm sóc Khách hàng đã ghi nhận yêu cầu:\n            </p>\n            <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#fdf2f8;border:1px solid #fbcfe8;border-radius:14px;overflow:hidden;margin-bottom:24px;\">\n              <tr>\n                <td style=\"background:#fce7f3;padding:12px 20px;border-bottom:1px solid #fbcfe8;font-size:13px;font-weight:800;color:#be185d;text-transform:uppercase;\">\n                  📋 THÔNG TIN TIẾP NHẬN YÊU CẦU\n                </td>\n              </tr>\n              <tr>\n                <td style=\"padding:20px;\">\n                  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"8\">\n                    <tr><td width=\"36%\" style=\"font-size:13px;color:#be185d;font-weight:600;\">Chủ đề thư:</td><td style=\"font-size:13px;font-weight:800;color:#0f172a;\">${subject}</td></tr>\n                    <tr><td style=\"font-size:13px;color:#be185d;font-weight:600;\">Phân loại phòng ban:</td><td><span style=\"background:#db2777;color:#ffffff;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:700;\">Hỏi đáp Chung (General)</span></td></tr>\n                    <tr><td style=\"font-size:13px;color:#be185d;font-weight:600;\">Mức độ ưu tiên:</td><td><strong style=\"color:#0f766e;font-size:13px;\">P4 - Low (Tiêu chuẩn)</strong></td></tr>\n                    <tr><td style=\"font-size:13px;color:#be185d;font-weight:600;\">Cam kết thời hạn SLA:</td><td><strong style=\"color:#be185d;font-size:13px;\">⏰ Trong vòng 24 giờ (Trước ${slaDeadlineStr})</strong></td></tr>\n                  </table>\n                </td>\n              </tr>\n            </table>\n\n            <div style=\"background:#f8fafc;border:1px solid #e2e8f0;padding:16px 20px;border-radius:10px;margin-bottom:28px;\">\n              <div style=\"font-size:13px;font-weight:800;color:#1e293b;margin-bottom:8px;\">🏢 THÔNG TIN VĂN PHÒNG &amp; GIỜ LÀM VIỆC CHI NHÁNH:</div>\n              <ul style=\"margin:0;padding-left:18px;font-size:12px;color:#64748b;line-height:1.7;\">\n                <li><strong>Địa chỉ:</strong> 470 Đường Trần Đại Nghĩa, Q. Ngũ Hành Sơn, TP. Đà Nẵng</li>\n                <li><strong>Giờ làm việc:</strong> Thứ Hai – Thứ Sáu (08:00 – 17:30) | Thứ Bảy (08:00 – 12:00)</li>\n                <li><strong>Tổng đài hỗ trợ:</strong> 1900 8888 (Miễn phí cước gọi)</li>\n              </ul>\n            </div>\n\n            <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n              <tr>\n                <td align=\"center\">\n                  <a href=\"http://localhost:3000/tickets\" target=\"_blank\" style=\"display:inline-block;background:linear-gradient(135deg, #be185d 0%, #db2777 100%);color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;padding:14px 32px;border-radius:10px;box-shadow:0 6px 18px rgba(219,39,119,0.35);\">\n                    👉 TRUY CẬP CỔNG DỊCH VỤ KHÁCH HÀNG CRM\n                  </a>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"background:#f8fafc;border-top:1px solid #e2e8f0;padding:24px 40px;text-align:center;\">\n            <p style=\"margin:0 0 4px;font-size:12px;font-weight:800;color:#334155;\">VKU ENTERPRISE CARE &bull; BAN CHĂM SÓC KHÁCH HÀNG</p>\n            <p style=\"margin:0;font-size:11px;color:#64748b;\">Hotline: 1900 8888</p>\n          </td>\n        </tr>\n      </table>\n    </td></tr>\n  </table>\n</body></html>`;\n}\n\nreturn [{\n  json: {\n    ...current,\n    sla_deadline: slaDeadlineDate.toISOString(),\n    sla_hours: slaHours,\n    email_subject: emailSubject,\n    email_html: emailHtml,\n    email_text: emailText\n  }\n}];\n"

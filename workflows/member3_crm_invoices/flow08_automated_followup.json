{
  "name": "Luồng 8: Automated Multi-Stage Follow-up & Nurturing",
  "nodes": [
    {
      "id": "f8-node-01",
      "name": "1. Follow-up Check Schedule Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "m3-flow8-followup-trigger",
      "parameters": {
        "httpMethod": "POST",
        "path": "m3-flow8-followup-trigger",
        "responseMode": "onReceived",
        "responseData": "OK",
        "options": {}
      }
    },
    {
      "id": "f8-node-02",
      "name": "2. Query Stale Sales Deals Postgres",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        440,
        300
      ],
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "http://localhost:4000/api/v1/crm/deals/stale",
        "options": {}
      }
    },
    {
      "id": "f8-node-03",
      "name": "3. Filter Blacklisted Leads Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst validDeals = items.filter(i => {\n  const d = i.json;\n  return d.email && !d.is_unsubscribed;\n});\n\nif (validDeals.length === 0) {\n  return [{\n    json: {\n      deal_id: 1,\n      deal_name: 'Deal ERP Mẫu',\n      email: 'lan.mai@vku.udn.vn',\n      full_name: 'Mai Hương Lan',\n      company_name: 'Đại học VKU',\n      expected_budget: 60000000,\n      followup_count: 1\n    }\n  }];\n}\n\nreturn validDeals;"
      }
    },
    {
      "id": "f8-node-04",
      "name": "4. Fetch Previous Chat Context Postgres",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        920,
        300
      ],
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://localhost:4000/api/v1/crm/deals/' + $json.deal_id }}",
        "options": {}
      }
    },
    {
      "id": "f8-node-05",
      "name": "5. Check Follow-up Stage Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        300
      ],
      "parameters": {
        "jsCode": "const item = $('3. Filter Blacklisted Leads Code').item.json;\nconst count = Number(item.followup_count || 0);\n\nlet stage_name = 'Giai đoạn 1: Thăm dò thân mật & Gửi hồ sơ năng lực';\nlet email_topic = 'Tài liệu giải pháp quản trị doanh nghiệp';\n\nif (count >= 2) {\n  stage_name = 'Giai đoạn 3: Đề xuất ưu đãi giới hạn trước khi đóng deal';\n  email_topic = 'Chính sách ưu đãi 15% triển khai tháng 10/2026';\n} else if (count >= 1) {\n  stage_name = 'Giai đoạn 2: Lời mời dùng thử và demo trực tiếp';\n  email_topic = 'Mời tham gia phiên demo trải nghiệm giải pháp';\n}\n\nreturn [{\n  json: {\n    ...item,\n    current_count: count,\n    stage_name,\n    email_topic\n  }\n}];"
      }
    },
    {
      "id": "f8-node-06",
      "name": "6. AI Follow-up Nurturing Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ `Bạn là Agent 6 (AI Follow-up Nurturing Agent). Hãy tạo email hỏi thăm chăm sóc deal: ${$('5. Check Follow-up Stage Code').first().json.deal_name}, Khách hàng: ${$('5. Check Follow-up Stage Code').first().json.full_name} (${$('5. Check Follow-up Stage Code').first().json.company_name}), Ngân sách: ${$('5. Check Follow-up Stage Code').first().json.expected_budget} VNĐ, Giai đoạn: ${$('5. Check Follow-up Stage Code').first().json.stage_name}. Trả về đúng JSON: {\"email_subject\": \"string\", \"email_body_html\": \"string\"}` }}",
        "options": {
          "systemMessage": "Bạn là AI Sales Nurturing Agent chuyên viết email chăm sóc khách hàng sau báo giá lịch thiệp, cá nhân hóa."
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "f8-node-07",
      "name": "7. Send Follow-up Email SMTP",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1640,
        300
      ],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "smtp": {
          "id": "Jtq10Z7c0pkw5YhZ",
          "name": "SMTP account"
        }
      },
      "parameters": {
        "fromEmail": "kieutrangg06123@gmail.com",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ (function() { try { const p = JSON.parse(String($json.output || '').replace(/```json/g,'').replace(/```/g,'').trim()); if (p.email_subject) return p.email_subject; } catch(e){} return '[NovaCRM] Chăm sóc giải pháp - ' + $('5. Check Follow-up Stage Code').first().json.deal_name; })() }}",
        "html": "={{ (function() { try { const p = JSON.parse(String($json.output || '').replace(/```json/g,'').replace(/```/g,'').trim()); if (p.email_body_html) return p.email_body_html; } catch(e){} return '<p>Kính gửi ' + ($('5. Check Follow-up Stage Code').first().json.full_name || 'Quý khách') + ',<br/>Đội ngũ NovaCRM xin phép liên hệ lại để hỗ trợ trao đổi giải pháp.</p>'; })() }}",
        "options": {}
      }
    },
    {
      "id": "f8-node-08",
      "name": "8. Update Deal Activity Timestamp HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1880,
        300
      ],
      "continueOnFail": true,
      "parameters": {
        "method": "PATCH",
        "url": "=http://127.0.0.1:4000/api/v1/crm/deals/{{ $('5. Check Follow-up Stage Code').first().json.deal_id }}/activity",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  stage: $('5. Check Follow-up Stage Code').first().json.current_count >= 2 ? 'COLD_LEAD' : 'QUOTED'\n}) }}",
        "options": {}
      }
    },
    {
      "id": "f8-node-09",
      "name": "9. IF Max Attempts Reached",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2120,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('5. Check Follow-up Stage Code').first().json.current_count }}",
              "rightValue": 2,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "f8-node-10",
      "name": "10. Mark Deal Stale & Task Sales HTTP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2360,
        200
      ],
      "parameters": {
        "jsCode": "const item = $('5. Check Follow-up Stage Code').first().json;\nreturn [{\n  json: {\n    ...item,\n    action: \"TASK_DIRECT_CALL_ASSIGNED\",\n    note: \"Đã vượt quá 3 lần gửi email không hồi âm. Đã gán task gọi điện trực tiếp cho Sales Rep.\"\n  }\n}];"
      }
    },
    {
      "id": "f8-node-11",
      "name": "11. Audit Follow-up Sent Postgres",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        2600,
        300
      ],
      "continueOnFail": true,
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4000/api/v1/audit/logs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  event_type: 'SALES_FOLLOWUP_DISPATCHED',\n  workflow_id: 'flow08_automated_followup',\n  description: 'Đã gửi email chăm sóc cho deal #' + $('5. Check Follow-up Stage Code').first().json.deal_id,\n  payload_snapshot: $('5. Check Follow-up Stage Code').first().json\n}) }}",
        "options": {}
      }
    },
    {
      "id": "f8-node-12",
      "name": "12. Complete Follow-up Cycle Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2840,
        300
      ],
      "parameters": {
        "jsCode": "return [{\n  json: {\n    status: \"FOLLOWUP_CYCLE_COMPLETED\",\n    executed_at: new Date().toISOString(),\n    message: \"Chu kỳ rà soát và gửi email follow-up Luồng 8 hoàn tất thành công.\"\n  }\n}];"
      }
    },
    {
      "id": "f8-node-06-model",
      "name": "Google Gemini Chat Model (Agent 6)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1400,
        480
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "gPALM992b8af9125",
          "name": "Google Gemini account"
        }
      },
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite"
      }
    }
  ],
  "connections": {
